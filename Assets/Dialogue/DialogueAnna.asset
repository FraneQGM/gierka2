  m_Script: {fileID: 11500000, guid: 995b94538c7bbfc44a6b0e186a1028fa, type: 3}
  m_Name: DialogueAnna
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  dialogueID: 
  requiredDialogues: []
  nodes:
  - text: "\u201EDobrze, \u017Ce przyszed\u0142e\u015B.\u201D"
  - text: "\u201EOd rana dziej\u0105 si\u0119 dziwne rzeczy przy magazynie.\u201D"
  - text: "\u201EWojsko pilnuje wej\u015Bcia i nikogo nie wpuszcza.\u201D"
  - text: "\u201EWidzia\u0142am te\u017C Kowalskiego. Wygl\u0105da\u0142 na zdenerwowanego.\u201D"
  - text: "\u201EMo\u017Ce on wie, co si\u0119 dzieje.\u201D"
